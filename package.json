{
  "name": "@jankrajewskiit/auth",
  "version": "3.6.4",
  "type": "module",
  "license": "MIT",
  "description": "SolidJS browser-side OIDC authentication framework wrapping oidc-client-ts.",
  "keywords": [
    "solidjs",
    "solid",
    "oidc",
    "oidc-client-ts",
    "authentication",
    "auth",
    "keycloak",
    "pkce",
    "silent-renew"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetauth.git"
  },
  "packageManager": "npm@12.2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "prettier": "@jankrajewskiit/configs/prettier",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "verify": "npm run toolchain && npm run editor:check && npm run format:check && npm run typecheck && npm run lint && npm run quality:check && npm run build && npm run verify:pkg",
    "verify:pkg": "npm run verify:types && publint --strict && attw --pack . --entrypoints . --profile esm-only",
    "prepublishOnly": "npm run verify",
    "prepare": "husky",
    "toolchain": "configs-toolchain",
    "audit:deps": "configs-audit",
    "prebuild": "npm run toolchain",
    "verify:types": "tsc -p tsconfig.declarations.json",
    "editor:sync": "configs-editor --write",
    "editor:check": "configs-editor",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "configs-unused",
    "architecture:check": "configs-architecture",
    "duplicates:report": "configs-duplicates",
    "quality:check": "npm run architecture:check && npm run duplicates:report && npm run deps:strict"
  },
  "peerDependencies": {
    "oidc-client-ts": ">=3.1.0 <4",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.7.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.3.4",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "~5.4.1"
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
