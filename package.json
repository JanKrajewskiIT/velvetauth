{
  "name": "@jankrajewskiit/auth",
  "version": "2.0.1",
  "type": "module",
  "license": "MIT",
  "description": "SolidJS browser-side OIDC authentication framework wrapping oidc-client-ts.",
  "keywords": [
    "solidjs",
    "solid",
    "oidc",
    "oidc-client-ts",
    "authentication",
    "auth",
    "keycloak",
    "pkce",
    "silent-renew"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankrajewskiit/velvet-auth.git"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "prettier": "@jankrajewskiit/configs/prettier",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "verify": "npm run typecheck && npm run lint && npm run build && publint && attw --pack --profile esm-only --ignore-rules internal-resolution-error",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "peerDependencies": {
    "oidc-client-ts": ">=3.1",
    "solid-js": ">=1.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@jankrajewskiit/configs": "^2.0.4",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.9.4",
    "publint": "^0.3.21",
    "solid-js": "^1.9.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
