{
  "name": "@jankrajewskiit/auth",
  "version": "3.4.1",
  "type": "module",
  "license": "MIT",
  "description": "SolidJS browser-side OIDC authentication framework wrapping oidc-client-ts.",
  "keywords": [
    "solidjs",
    "solid",
    "oidc",
    "oidc-client-ts",
    "authentication",
    "auth",
    "keycloak",
    "pkce",
    "silent-renew"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetauth.git"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "prettier": "@jankrajewskiit/configs/prettier",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run verify:pkg",
    "verify:pkg": "publint --strict && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "peerDependencies": {
    "oidc-client-ts": ">=3.1.0 <4",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4"
  }
}
