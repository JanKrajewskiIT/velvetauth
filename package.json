{
  "name": "@jankrajewskiit/auth",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetauth.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "npm@11.13.0",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepare": "husky"
  },
  "peerDependencies": {
    "oidc-client-ts": ">=3.1.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@jankrajewskiit/configs": "^1.1.8",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "solid-js": "^1.9.12",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0"
  }
}
